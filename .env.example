# ─── Server ───────────────────────────────────────
PORT=9000
ENVIRONMENT=production    # development | staging | production
BASE_URL=https://licensing.example.com  # Public URL (TLS required in production for secure session cookies)

# ─── Database (Docker Compose or External PostgreSQL) ───────────────────
# When using Docker Compose, set POSTGRES_PASSWORD and leave DATABASE_URL unset
# or construct it from the variables below.
POSTGRES_USER=keygate
POSTGRES_PASSWORD=        # Required for production Docker Compose (generate: openssl rand -base64 24)
POSTGRES_DB=keygate
# Explicit connection string (overrides POSTGRES_* defaults above):
# DATABASE_URL=postgres://keygate:<password>@postgres:5432/keygate?sslmode=disable

# ─── Security & Cryptographic Keys (Required) ───────────────────────────
# JWT Secret: HMAC-SHA256 key for admin & portal sessions (minimum 32 chars).
# Generate with: openssl rand -hex 32
JWT_SECRET=

# License Signing Key: 32-byte Ed25519 seed in hex (exactly 64 hex characters).
# Used to sign offline tokens and license entitlement tokens.
# Generate with: openssl rand -hex 32
# NOTE: Store securely! Never commit to VCS or bundle into client SDKs.
LICENSE_SIGNING_KEY=

# Master Encryption Key (Recommended in production, Required if Release Storage is enabled):
# AES-256-GCM master key (exactly 64 hex characters / 32 bytes) used to encrypt
# product release-signing private keys and license keys at rest in the database.
# Generate with: openssl rand -hex 32
# CAUTION: Back this key up! Losing this key permanently locks all encrypted keys and releases.
RELEASE_KEY_ENCRYPTION_KEY=

# ─── Migrations ──────────────────────────────────
# Directory containing .up.sql migrations (defaults to db/migrations)
MIGRATIONS_DIR=db/migrations
# Set to "true" to run migrations and immediately exit (useful in CI/CD pre-deploy hooks)
MIGRATE_ONLY=false

# ─── Admin Bootstrap ─────────────────────────────
# Comma-separated emails to auto-promote to admin on first login
# (to owner while the install has no owner). When set, only these
# emails can complete first-run setup.
ADMIN_EMAILS=admin@example.com

# ─── Payments (Stripe) ──────────────────────────
# Stripe Dashboard: https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY: sk_live_... for production, sk_test_... for staging/dev.
STRIPE_SECRET_KEY=
# Optional: STRIPE_WEBHOOK_SECRET (whsec_...) if manual endpoint is configured.
STRIPE_WEBHOOK_SECRET=
# STRIPE_LIVEMODE: auto-derived from secret key prefix (sk_live_ vs sk_test_)
# unless explicitly set to "true" or "false".
STRIPE_LIVEMODE=

# ─── Email (SMTP) ────────────────────────────────
# Required for OTP login and notification emails in production.
# If unset, OTP codes print to server stdout logs.
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Either a bare address or display-name form (e.g., "Keygate Licensing <noreply@example.com>")
SMTP_FROM=noreply@example.com

# ─── Distributed Rate Limiting (Redis / Valkey) ───
# Optional: when set, rate limits are coordinated across multiple Keygate instances.
# If unset or unreachable, falls back gracefully to in-memory rate limiting.
# Example: redis://default:password@redis:6379/0
REDIS_URL=

# ─── Rate Limits (requests per minute) ───────────
RATE_LIMIT_API=60
RATE_LIMIT_ADMIN=120
RATE_LIMIT_AUTH=60
# Login codes per IP per HOUR (tightly capped to prevent email relay abuse)
RATE_LIMIT_OTP_SEND=30

# ─── Brute-Force Protection ───────────────────────
BF_MAX_FAILS=5
BF_LOCKOUT_SECONDS=30

# ─── Webhooks ────────────────────────────────────
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_RETRY_INTERVAL=30s
WEBHOOK_HTTP_TIMEOUT=10s
# Allow webhook deliveries to loopback/private/link-local addresses (false in production)
WEBHOOK_ALLOW_PRIVATE=false

# ─── Quotas ──────────────────────────────────────
QUOTA_WARNING_THRESHOLD=0.8

# ─── Release Storage (Optional, S3-Compatible) ───
# Required only if distributing software release binaries and signed updates.
# Supports AWS S3, Cloudflare R2, MinIO, Wasabi, DigitalOcean Spaces, etc.
# Leave STORAGE_BUCKET empty to disable release storage (license management still works).
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=
# Set to "true" for MinIO or self-hosted S3 gateways requiring path-style URLs
STORAGE_FORCE_PATH_STYLE=false
# Presigned URL Lifetimes
STORAGE_UPLOAD_TTL=1h
STORAGE_DOWNLOAD_TTL=10m
STORAGE_FEED_URL_TTL=24h

# Master key that encrypts secrets at rest: release-signing keys, email
# provider credentials and license keys. Required when release storage
# is enabled; recommended in any production install.
# Generate with: openssl rand -hex 32
# Keep it safe and stable: losing or changing it makes existing signing
# keys undecryptable, and signing then fails.
RELEASE_KEY_ENCRYPTION_KEY=

# Largest artifact the server will read, hash and sign at publish, in MB.
MAX_RELEASE_SIGN_SIZE_MB=500
